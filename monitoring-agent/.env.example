# Copy to `.env` in the deployed folder on each host. `.env` is gitignored.
#
# AGENT_HOST is the label every log line from this host gets tagged with in
# Loki. It is REQUIRED: if the file is missing, docker compose substitutes an
# empty string with no error, promtail starts happily, and the host's logs
# arrive unlabelled and unfilterable in Grafana. Nothing else reports a problem.
#
# This is exactly what happened on jarvis: the .env was never created, and its
# logs were unqueryable until 2026-08-16.
#
# Verify after deploying:
#   docker inspect promtail --format '{{range .Config.Env}}{{println .}}{{end}}' | grep AGENT_HOST
#   curl -s http://192.168.1.199:3100/loki/api/v1/label/host/values
#
# Use the short host name: starr | plex | cloud | jarvis

AGENT_HOST=CHANGEME
