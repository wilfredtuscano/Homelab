# Copy to `.env` on cloud-ct and fill in. `.env` is gitignored — never commit it.

# --- Core Paperless ---------------------------------------------------------
# Postgres password (shared by webserver + db). Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# Django secret key. Generate: openssl rand -base64 48
PAPERLESS_SECRET_KEY=

# Bootstrap superuser created on first boot. Rotate the password after setup.
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=

# --- AI add-ons (only needed for `--profile ai`) ----------------------------
# API token for a Paperless superuser. Create AFTER first boot:
#   Paperless UI -> Settings -> (user) -> API Token. Then put it here and
#   bring the AI services up. paperless-ai mostly reads its token from its own
#   web UI, but paperless-gpt needs it here.
PAPERLESS_API_TOKEN=

# Ollama models served by jarvis (https://ollama.local.wilfredtuscano.com).
# Vision model does image-based OCR; text model does metadata suggestions.
# Pull them first:  ollama pull qwen2.5vl:32b
GPT_VISION_MODEL=qwen2.5vl:32b
GPT_TEXT_MODEL=qwen2.5vl:32b
